{
  "version": 2,
  "functions": {
    "api/profile-picture.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/start/" },
    { "source": "/etapa2", "destination": "/start/etapa2/" },
    { "source": "/etapa2/(.*)", "destination": "/start/etapa2/$1" },
    { "source": "/concluido2", "destination": "/start/concluido2/" },
    { "source": "/concluido2/(.*)", "destination": "/start/concluido2/$1" }
  ],
  "cleanUrls": true
}
