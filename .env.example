# URL interna/base do servidor WAHA. Nunca exponha esta configuração no frontend.
WAHA_BASE_URL=http://127.0.0.1:3001
# Chave opcional, se a instalação WAHA exigir autenticação.
WAHA_API_KEY=
# Se o domínio estiver protegido por HTTP Basic, informe as credenciais no backend.
WAHA_USERNAME=
WAHA_PASSWORD=
WAHA_SESSION=default
PORT=3000
HOST=127.0.0.1
DEFAULT_COUNTRY_CODE=55
PROFILE_PICTURE_CACHE_TTL_MS=86400000
WAHA_REQUEST_TIMEOUT_MS=8000
PROFILE_PICTURE_RATE_LIMIT=30
